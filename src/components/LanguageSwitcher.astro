---
import { defaultLocale, languageNames, translate, type Locale } from '../i18n/config';
interface Props { locale?: Locale; mobile?: boolean; footer?: boolean; tag?: "div" | "li" }
const { locale = defaultLocale, mobile = false, footer = false, tag: Tag = "div" } = Astro.props;
const t = translate(locale);
---
<Tag class={mobile ? 'language-selection-mobile' : 'language-selection-desktop'}>
  <a href="#" role="button" class={mobile ? 'btn btn-default dropdown-toggle' : 'dropdown-toggle'} data-chrome-toggle aria-haspopup="true" aria-expanded="false" title="Sprachauswahl" aria-label={t.language}>
    <span class="icon-globe" aria-hidden="true"></span>{!mobile && <> {t.language} <span class="caret"></span></>}
  </a>
  <ul class:list={['dropdown-menu', { 'dropdown-menu-right': !footer }]}>
    <li><strong style="padding:3px 20px;" lang={locale} aria-current="true">{languageNames[locale]}</strong></li>
  </ul>
</Tag>
