---
import SiteLayout from "../layouts/SiteLayout.astro";
import { defaultLocale, translate } from "../i18n/config";
const t = translate(defaultLocale);
import ObjectSearch from "../components/ObjectSearch.vue";
---

<style>
  .intro {
    background: var(--primary-color);
    color: #fff;
    padding: var(--space-default);
    margin-top: var(--space-default);
  }

  .intro h1 {
    color: inherit;
  }

  .search {
    background: var(--background-color);
    padding: var(--space-default);
  }
</style>
<SiteLayout title={t.database}>
  <div class="intro">
    <h1>{t.database}</h1>
  </div>

  <div class="search">
    <ObjectSearch locale={defaultLocale} client:load />
    <noscript
      >{t.noScript}</noscript
    >
  </div>
</SiteLayout>
