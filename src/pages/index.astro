---
import SiteLayout from "../layouts/SiteLayout.astro";
import ObjectSearch from "../components/ObjectSearch.vue";
---

<style>
  .intro {
    background: var(--primary-color);
    color: #fff;
    padding: var(--space-default);
    margin-top: var(--space-default);
  }

  .search {
    background: var(--background-color);
    padding: var(--space-default);
  }
</style>
<SiteLayout title="Objektdatenbank">
  <div class="intro">
    <h1>Objektdatenbank</h1>
  </div>

  <div class="search">
    <ObjectSearch client:load />
    <noscript
      >JavaScript muss aktiviert sein, um die Objektsuche zu verwenden.</noscript
    >
  </div>
</SiteLayout>
