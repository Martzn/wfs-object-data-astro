---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ObjectSearch from "../../components/ObjectSearch.vue";
import { locales } from "../../i18n/config";
import { translate } from "../../i18n/messages";
export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const { common, search: t } = translate(locale);
---

<style>
  .intro {
    background: var(--primary-color);
    color: #fff;
    padding: var(--space-default);
    margin-top: var(--space-default);
  }

  .intro h1 {
    color: inherit;
  }

  .search {
    background: var(--background-color);
    padding: var(--space-default);
  }
</style>
<SiteLayout title={common.database} locale={locale}>
  <div class="intro">
    <h1>{common.database}</h1>
  </div>

  <div class="search">
    <ObjectSearch locale={locale} client:load />
    <noscript
      >{t.noScript}</noscript
    >
  </div>
</SiteLayout>
