---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import ObjectSearch from "../../../components/ObjectSearch.vue";
import { locales } from "../../../i18n/config";
import { translate } from "../../../i18n/messages";
import { getObjects } from "../../../lib/objects";
import { searchPath } from "../../../i18n/paths";
import { objectTypes } from "../../../lib/objectTypes";
export function getStaticPaths() {
  return locales.flatMap(locale => objectTypes.map(type => ({ params: { locale, type }, props: { locale, type } })));
}
const { locale, type } = Astro.props;
const { search: t } = translate(locale);
const introduction = t.introductions[type];
// Both sections currently use the same sample data.
const objects = await getObjects();
const otherType = type === 'areas' ? 'properties' : 'areas';
const companyUrl = locale === 'de'
  ? 'https://firmen.standort-sachsen.de/company/de/'
  : 'https://companies.business-saxony.com/company/en/';
---

<SiteLayout title={introduction.title} locale={locale}>
  <div class="intro-sections">
  <section class="search-heading">
    <div class="box headline">
      <h1>{introduction.title}</h1>
    </div>
  </section>
  <section class="brand-primary introduction">
    <div class="row row-equal-height">
      <div class="col-xs-12 col-md-8 csc-default">
        <div class="box">
          <div class="teaser">
            <h2>{introduction.available(objects.length)}</h2>
            <div class="content"><p>{introduction.description}</p></div>
          </div>
        </div>
      </div>
      <div class="col-xs-12 col-md-4 csc-default">
        <div class="box links">
          <div class="teaser">
            <h2>{t.researchTools}</h2>
            <div class="content">
              <ul class="list-group">
                <li class="list-group-item"><div class="icon-arrow-right icon-padding"><a href={companyUrl}>{t.companies}</a></div></li>
                <li class="list-group-item"><div class="icon-arrow-right icon-padding"><a href={searchPath(locale, otherType)}>{t.introductions[otherType].title}</a></div></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  </div>
  <section class="box-gray padding-bottom">
    <ObjectSearch locale={locale} type={type} client:load />
    <noscript>{t.noScript}</noscript>
  </section>
</SiteLayout>

<style>
  /* A shared background prevents fractional-pixel seams between green sections. */
  .intro-sections { background: var(--primary-color); }
  /* Full-width on mobile; the original five-column title block on desktop. */
  .search-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0;
    border-top: 30px solid #fff;
  }
  .search-heading .headline { min-width: 0; width: auto; margin: 0; }
  @media (min-width: 768px) {
    .search-heading {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      background: #fff;
    }
  }
  @media (min-width: 992px) {
    .search-heading {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      padding-right: 30px;
    }
  }

  /* Replace the source site's equal-height JavaScript with responsive CSS. */
  .row-equal-height { display: flex; flex-wrap: wrap; align-items: stretch; }
  .row-equal-height > div { display: flex; }
  /* Override the original percentage height so the flex items can stretch. */
  .row-equal-height > div > .box { width: 100%; height: auto; flex: 1; }
</style>
