---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getObjects } from "../../../lib/objects";
import SearchNavigation from "../../../components/SearchNavigation.vue";

import { locales } from "../../../i18n/config";
import { translate } from "../../../i18n/messages";

export async function getStaticPaths() {
  const objects = await getObjects();

  return locales.flatMap(locale => objects.map((object) => ({
    params: { locale, id: object.id },
    props: { object, locale },
  })));
}

const { object, locale } = Astro.props;
const t = translate(locale).objectDetails;
---

<SiteLayout title={object.objectName} locale={locale}>
  <h1>{object.objectName}</h1>
  <SearchNavigation objectId={object.id} locale={locale} client:load />
  <div class="object-details">
    <div class="description">
      <p>{object.description}</p>
      <p>
        {object.address.street}<br />
        {object.address.postalCode}
        {object.address.city}
      </p>
      <p>{object.category}</p>
    </div>

    <div class="map">
      <div class="map-base">
        <iframe
          title={`${t.mapLocation}: ${object.objectName}`}
          src={`https://maps.google.com/maps?q=${object.coordinates.latitude},${object.coordinates.longitude}&z=15&output=embed`}
          width="100%"
          height="400"
          style="border: 0;"
          loading="lazy"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  h1 {
    background: var(--primary-color);
    color: #fff;
    padding: var(--space-default) var(--space-default) 5px var(--space-default);
    margin-bottom: 0;
    margin-top: var(--space-default);
  }

  .object-details {
    display: grid;
    gap: var(--space-default);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--background-color);
    padding: var(--space-default);
  }

  @media (max-width: 700px) {
    .object-details {
      grid-template-columns: 1fr;
    }
  }

  .description {
    background: #fff;
    padding: var(--space-default);
  }

  .map {
    position: relative;
    isolation: isolate;
    background: #fff;
    padding: var(--space-default);
  }

  .map-base {
    filter: grayscale(100%);
  }

  .map iframe {
    display: block;
  }
</style>
